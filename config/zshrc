path=("$HOME/.local/bin" $path)

# NVM (Node Version Manager) — lazy-loaded so it doesn't slow shell startup
# (nvm.sh is ~200-800ms) or register a chpwd hook before zoxide's. The shims
# below source nvm on first use of nvm/node/npm/npx, then hand off.
export NVM_DIR="$HOME/.nvm"
_load_nvm() {
  unset -f nvm node npm npx 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"
}
nvm()  { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm()  { _load_nvm; npm "$@"; }
npx()  { _load_nvm; npx "$@"; }

# direnv
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# zoxide must be initialized last so its hook runs after every other tool's.
# _ZO_DOCTOR=0 suppresses a false-positive warning: p10k's async precmd / nvm's
# chpwd hook register after the first prompt, which zoxide's doctor misreads.
export _ZO_DOCTOR=0
eval "$(zoxide init zsh)"
